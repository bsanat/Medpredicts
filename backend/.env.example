# Copy to backend/.env (git-ignored) and fill in. Real environment variables override these values.
# Never commit backend/.env. Never put a real key in this example file.

# Google Gemini key for the documentation assistant (https://aistudio.google.com -> API keys).
# Empty = assistant disabled (503 ASSISTANT_UNAVAILABLE).
GEMINI_API_KEY=

# Optional assistant settings
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low
# ASSISTANT_REQUESTS_PER_MINUTE=20

# Trained model bundle for the onnx profile (absolute path recommended)
# MEDPREDICT_MODEL_DIRECTORY=/absolute/path/to/MedPredictt/ml-ai/artifacts
